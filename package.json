{
  "name": "localvoice",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "llama.rn": "0.13.0-rc.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "android:build": "expo run:android",
    "pc:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-pc.ps1",
    "pc:start": ".venv-pc\\Scripts\\python.exe pc/server.py",
    "pc:bluetooth-test": ".venv-pc\\Scripts\\python.exe pc/bluetooth_probe.py",
    "pc:test": ".venv-pc\\Scripts\\python.exe -m unittest discover -s pc/tests"
  },
  "private": true
}
